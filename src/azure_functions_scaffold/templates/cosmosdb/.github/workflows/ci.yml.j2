name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "{{ python_version }}"
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -e .{% if include_ruff or include_mypy or include_pytest %}[dev]{% endif %}
      - name: Run checks
        run: |
          {% if include_ruff -%}
          ruff check .
          ruff format --check .
          {% endif -%}
          {% if include_mypy -%}
          mypy .
          {% endif -%}
          {% if include_pytest -%}
          pytest
          {% endif -%}
